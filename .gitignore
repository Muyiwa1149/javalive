# Root-level ignores; backend/ and frontend/ have their own nested .gitignore files too.
.env
.env.*
!.env.example
*.log
.DS_Store
Thumbs.db

# Phase 7 Playwright QA harness — scripts are useful to keep, but not their node_modules/output.
qa-testing/node_modules/
qa-testing/screenshots/
qa-testing/*.json
qa-testing/*token*.txt
qa-testing/*.png

# Real production data dumps — contain PII, password hashes, financial records. Never commit these,
# even to a private repo; transfer to the VPS directly (scp/rsync) and delete the local copy after.
data-migration/dumps/
