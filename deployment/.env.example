# Copy to deployment/.env and fill in real values before running docker-compose,
# or export these same variables directly when running the jar natively (see README.md).

# --- Database ---
DB_ROOT_PASSWORD=change-me
DB_USERNAME=javalive
DB_PASSWORD=change-me
# Only needed when NOT using docker-compose (which builds this URL itself from the vars above):
# DB_URL=jdbc:mysql://localhost:3306/javalive_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8

# --- Mail (SMTP) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@yourdomain.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# --- Security (generate real, unique values — never reuse the dev defaults) ---
# 32+ byte random string, e.g.: openssl rand -base64 48
JWT_SECRET=
# AES-256 key, 32 raw bytes base64-encoded, e.g.: openssl rand -base64 32
ENCRYPTION_KEY=

# --- URLs ---
CORS_ALLOWED_ORIGINS=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# --- Optional external integrations (leave blank to disable) ---
FINNHUB_API_KEY=
