# Multi-stage build: compile the fat jar, then run it on a slim JRE-only image.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY backend/pom.xml .
RUN mvn -q -B dependency:go-offline
COPY backend/src ./src
RUN mvn -q -B clean package -DskipTests

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S javalive && adduser -S javalive -G javalive
COPY --from=build /build/target/backend-0.0.1-SNAPSHOT.jar app.jar
RUN mkdir -p /app/storage/public && chown -R javalive:javalive /app
USER javalive
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar", "--spring.profiles.active=prod"]
