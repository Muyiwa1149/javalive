# Builds the Vue static bundle, then serves it (plus reverse-proxies /api and /storage to the
# backend) with nginx. Build with the deployment/ directory as the Docker build context so both
# ../frontend and this file's nginx.conf are reachable.
FROM node:20-alpine AS build
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /build/dist /usr/share/nginx/html
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
